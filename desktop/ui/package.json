{
  "name": "phone-auth-tray",
  "productName": "PhoneAuth",
  "version": "0.1.5",
  "description": "Tray UI for the PhoneAuth background agent",
  "author": "Luis Phillip Lemos Martins <107713925+Gaok1@users.noreply.github.com>",
  "homepage": "https://github.com/Gaok1/BioAuth",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node ../../tools/make-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "addons-linter": "^10.10.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "org.bioauth.phoneauth",
    "productName": "PhoneAuth",
    "copyright": "MIT licensed",
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/verify-authenticode.ps1",
        "to": "verify-authenticode.ps1"
      },
      {
        "from": "../target/release/",
        "to": "bin",
        "filter": [
          "phone-auth-agent",
          "phone-auth-agent.exe",
          "phone-auth",
          "phone-auth.exe",
          "phone-auth-webauthn-host",
          "phone-auth-webauthn-host.exe"
        ]
      },
      {
        "from": "../browser-extension/",
        "to": "browser-extension"
      },
      {
        "from": "../file-manager/",
        "to": "file-manager",
        "filter": [
          "phone-auth-file-manager.ps1",
          "phone-auth-file-manager.cmd",
          "phone-auth-file-manager.sh",
          "install-nautilus.sh"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "PhoneAuth-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "PhoneAuth",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "PhoneAuth"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility;Security",
      "synopsis": "Phone-as-authenticator for desktop logins",
      "description": "Tray UI and background verifier for PhoneAuth. Approvals are signed by a hardware-backed key on a paired phone; this machine only ever verifies.",
      "artifactName": "PhoneAuth-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "PhoneAuth",
          "Comment": "Approve desktop logins from your phone",
          "Categories": "Utility;Security;",
          "StartupNotify": "false"
        }
      }
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "zenity"]
    },
    "publish": null
  }
}
