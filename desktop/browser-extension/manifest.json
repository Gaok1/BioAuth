{
  "manifest_version": 3,
  "name": "PhoneAuth Passkeys",
  "default_locale": "en",
  "version": "1.0.2",
  "description": "Relays WebAuthn requests to a paired PhoneAuth device.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://*.localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "autofill-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webauthn@bioauth.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_title": "Preencher senha do cofre"
  }
}
